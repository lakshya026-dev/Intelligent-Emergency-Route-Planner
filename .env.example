# Environment Variables for Intelligent Emergency Route Planner
# Copy this file to .env and adjust values as needed.

# CARTO Basemaps API Configuration
CARTO_API_KEY=your_carto_api_key_here

# Default city to load on startup
DEFAULT_CITY=Dublin, Ireland

# Enable/disable graph caching
GRAPH_CACHE_ENABLED=true

# Traffic simulation random seed
TRAFFIC_RANDOM_SEED=42

# Use fallback sample graph when OpenStreetMap is unreachable
USE_FALLBACK_IF_OFFLINE=true
